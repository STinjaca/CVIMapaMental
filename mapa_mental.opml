<?xml version="1.0" encoding="UTF-8"?>
<opml version="1.0">
  <head>
    <title>Conocimiento necesario Computacion grafica</title>
  </head>
  <body>
    <outline text="Actualidad">
      <outline text="Hardware">
        <outline text="GPU">
          <outline text="Nvidia"></outline>
          <outline text="AMD"></outline>
        </outline>
      </outline>
      <outline text="Video juegos"></outline>
      <outline text="Realidad Virtual"></outline>
    </outline>
    <outline text="Viewing">
      <outline text="Matriz de proyeccion perspectiva"></outline>
      <outline text="Division homogenea"></outline>
      <outline text="NDC"></outline>
      <outline text="Frustum"></outline>
      <outline text="Ortografica vs perspectiva"></outline>
      <outline text="Clip space"></outline>
      <outline text="View matrix (look-at)"></outline>
    </outline>
    <outline text="Ray Tracing">
      <outline text="Rayos de sombra"></outline>
      <outline text="Interseccion rayo-esfera"></outline>
      <outline text="Materiales">
        <outline text="Lambertiano"></outline>
        <outline text="Dielectrico (vidrio)"></outline>
      </outline>
    </outline>
    <outline text="C++">
      <outline text="Libreria STL"></outline>
      <outline text="xcode"></outline>
    </outline>
    <outline text="Matematicas">
      <outline text="Alegra lineal">
        <outline text="coordenadas Homogeneas"></outline>
        <outline text="vectores"></outline>
      </outline>
      <outline text="Rotaciones">
        <outline text="Quaterniones">
          <outline text="lerp"></outline>
          <outline text="slerp"></outline>
        </outline>
        <outline text="Eurler">
          <outline text="lock"></outline>
        </outline>
        <outline text="eje natural"></outline>
      </outline>
    </outline>
    <outline text="Imagenes Raster">
      <outline text="Cuantizacion">
        <outline text="Error de cuantizacion"></outline>
      </outline>
      <outline text="Dithering">
        <outline text="Floyd-Steinberg (1976)"></outline>
      </outline>
      <outline text="Halftoning">
        <outline text="AM vs FM screening"></outline>
      </outline>
      <outline text="dpi vs ppi"></outline>
    </outline>
  </body>
</opml>
